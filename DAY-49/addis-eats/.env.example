# Copy to .env.local for local development:  cp .env.example .env.local

# REQUIRED in production. Signs the session cookie (HMAC-SHA256).
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Server-only — never prefix with NEXT_PUBLIC_.
SESSION_SECRET=

# Public site origin, used for metadataBase, og:image, sitemap and robots.
# NEXT_PUBLIC_ values are inlined into the bundle at build time — never put a secret here.
# Optional on Vercel (falls back to VERCEL_PROJECT_PRODUCTION_URL).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

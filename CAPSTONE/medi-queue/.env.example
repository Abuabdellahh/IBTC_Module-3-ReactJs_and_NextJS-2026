# ─────────────────────────────────────────────────────────────
# MediQueue — Environment Variables Template
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# ⚠️  Never commit .env to version control.
# ⚠️  All browser-exposed variables MUST start with VITE_
# ─────────────────────────────────────────────────────────────

# App
VITE_APP_TITLE=MediQueue

# API (uncomment and set when backend is ready)
# VITE_API_BASE_URL=http://localhost:4000/api
